{
  "compilerOptions": {
    "target": "ES2023",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "lib": [
      "ES2023"
    ],
    "declaration": true,
    "declarationMap": true,
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "outDir": "dist",
    "rootDir": ".",
    "emitDeclarationOnly": true,
    "plugins": [
      {
        "name": "@effect/language-service"
      }
    ],
    "allowImportingTsExtensions": true
  },
  "include": [
    "src",
    "bin"
  ],
  "exclude": [
    "node_modules",
    "dist"
  ]
}
